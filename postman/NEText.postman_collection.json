{
  "info": {
    "name": "NEText API",
    "description": "Start the database (docker compose up -d) and the API (dotnet run --project src/NEText.Api) first.\n\nRun Login first: its token is sent with every request. Search users stores the first result as {{userId}}, which is the target of the friend, conversation and group requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5180"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "myId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    },
    {
      "key": "conversationId",
      "value": ""
    },
    {
      "key": "groupId",
      "value": ""
    },
    {
      "key": "messageId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"username\": \"alice\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', pm.response.json().accessToken);",
                  "  pm.collectionVariables.set('myId', pm.response.json().user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Search users",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 && pm.response.json().length > 0) pm.collectionVariables.set('userId', pm.response.json()[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/users/search?q=bob",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "bob"
                }
              ]
            }
          }
        },
        {
          "name": "Get user by id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "Friends",
      "item": [
        {
          "name": "Send friend request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('requestId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toUserId\": \"{{userId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/friend-requests"
          }
        },
        {
          "name": "Incoming requests",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 && pm.response.json().length > 0) pm.collectionVariables.set('requestId', pm.response.json()[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/friend-requests/incoming"
          }
        },
        {
          "name": "Outgoing requests",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/friend-requests/outgoing"
          }
        },
        {
          "name": "Accept request",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/friend-requests/{{requestId}}/accept"
          }
        },
        {
          "name": "Decline request",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/friend-requests/{{requestId}}/decline"
          }
        },
        {
          "name": "Cancel request",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/friend-requests/{{requestId}}"
          }
        },
        {
          "name": "My friends",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/friends"
          }
        },
        {
          "name": "Remove friend",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/friends/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "Conversations",
      "item": [
        {
          "name": "Start direct conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) pm.collectionVariables.set('conversationId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/conversations"
          }
        },
        {
          "name": "My conversations",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/conversations"
          }
        },
        {
          "name": "My direct chats",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/conversations?type=Direct",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversations"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "Direct"
                }
              ]
            }
          }
        },
        {
          "name": "My groups",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/conversations?type=Group",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversations"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "Group"
                }
              ]
            }
          }
        },
        {
          "name": "Get conversation",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/conversations/{{conversationId}}"
          }
        },
        {
          "name": "Mark as read",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/conversations/{{conversationId}}/read"
          }
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Send message",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('messageId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hi! How are you?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/conversations/{{conversationId}}/messages"
          }
        },
        {
          "name": "Get messages",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/messages?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversations",
                "{{conversationId}}",
                "messages"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "Get messages (without deleted)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/messages?limit=50&includeDeleted=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversations",
                "{{conversationId}}",
                "messages"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "includeDeleted",
                  "value": "false"
                }
              ]
            }
          }
        },
        {
          "name": "Get unread messages",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/messages?unreadOnly=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversations",
                "{{conversationId}}",
                "messages"
              ],
              "query": [
                {
                  "key": "unreadOnly",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Get older messages (before)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/messages?limit=50&before={{messageId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversations",
                "{{conversationId}}",
                "messages"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "before",
                  "value": "{{messageId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Edit message",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hi! How are you doing?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/messages/{{messageId}}"
          }
        },
        {
          "name": "Delete message",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/messages/{{messageId}}"
          }
        }
      ]
    },
    {
      "name": "Groups",
      "item": [
        {
          "name": "Create group",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('groupId', pm.response.json().id);",
                  "  pm.collectionVariables.set('conversationId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Weekend trip\",\n  \"memberIds\": [\n    \"{{userId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/groups"
          }
        },
        {
          "name": "Group members",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/groups/{{groupId}}/members"
          }
        },
        {
          "name": "Group admins",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/groups/{{groupId}}/members?role=Admin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups",
                "{{groupId}}",
                "members"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "Admin"
                }
              ]
            }
          }
        },
        {
          "name": "Group members (only Members)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/groups/{{groupId}}/members?role=Member",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups",
                "{{groupId}}",
                "members"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "Member"
                }
              ]
            }
          }
        },
        {
          "name": "Add member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/groups/{{groupId}}/members"
          }
        },
        {
          "name": "Remove member",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/groups/{{groupId}}/members/{{userId}}"
          }
        },
        {
          "name": "Change member role",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"Admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/groups/{{groupId}}/members/{{userId}}/role"
          }
        },
        {
          "name": "Set my nickname",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickname\": \"The planner\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/groups/{{groupId}}/members/me/nickname"
          }
        },
        {
          "name": "Rename group",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Summer trip\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/groups/{{groupId}}"
          }
        },
        {
          "name": "Leave group",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/groups/{{groupId}}/leave"
          }
        },
        {
          "name": "Delete group",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/groups/{{groupId}}"
          }
        }
      ]
    }
  ]
}
