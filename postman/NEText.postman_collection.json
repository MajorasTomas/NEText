{
  "info": {
    "name": "NEText API",
    "description": "Requests for the NEText messenger API. Start the database (`docker compose up -d`) and the API (`dotnet run --project src/NEText.Api`, listens on http://localhost:5180) first.\n\nAuth: every request sends `Authorization: Bearer {{token}}` (set on the collection). Run a Login request first; it saves the token. Whichever Login you ran last is the current user. Health/Register/Login are set to No Auth.\n\nThe only scripts save values from responses into collection variables (token, ids).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5180" },
    { "key": "token", "value": "" },
    { "key": "aliceId", "value": "" },
    { "key": "bobId", "value": "" },
    { "key": "requestId", "value": "" },
    { "key": "conversationId", "value": "" },
    { "key": "messageId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (Alice)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save the new user's id for other requests ({{aliceId}})",
                  "if (pm.response.code === 201) pm.collectionVariables.set('aliceId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"username\": \"Alice\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Register (Bob)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save the new user's id for other requests ({{bobId}})",
                  "if (pm.response.code === 201) pm.collectionVariables.set('bobId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob@example.com\",\n  \"username\": \"bob\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login (Alice)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save the token: every request in the collection sends it as 'Authorization: Bearer {{token}}'",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', pm.response.json().accessToken);",
                  "  pm.collectionVariables.set('aliceId', pm.response.json().user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login (Bob)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save the token: every request in the collection sends it as 'Authorization: Bearer {{token}}'",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', pm.response.json().accessToken);",
                  "  pm.collectionVariables.set('bobId', pm.response.json().user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Me (current user)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get user by id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/{{bobId}}"
          }
        },
        {
          "name": "Search users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/users/search?q=al",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "search"],
              "query": [{ "key": "q", "value": "al" }]
            }
          }
        }
      ]
    },
    {
      "name": "Friends",
      "description": "Requests act as whoever logged in last. Typical flow: Login (Alice) -> Send request (to Bob) -> Login (Bob) -> Incoming -> Accept or Decline. Cancel is done by the sender (Alice).",
      "item": [
        {
          "name": "Send request (to Bob)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save the request id for Accept/Decline/Cancel ({{requestId}})",
                  "if (pm.response.code === 201) pm.collectionVariables.set('requestId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toUserId\": \"{{bobId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/friend-requests"
          }
        },
        {
          "name": "Incoming requests",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/friend-requests/incoming"
          }
        },
        {
          "name": "Outgoing requests",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/friend-requests/outgoing"
          }
        },
        {
          "name": "Accept request",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/friend-requests/{{requestId}}/accept"
          }
        },
        {
          "name": "Decline request",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/friend-requests/{{requestId}}/decline"
          }
        },
        {
          "name": "Cancel request",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/friend-requests/{{requestId}}"
          }
        },
        {
          "name": "My friends",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/friends"
          }
        },
        {
          "name": "Remove friend (Bob)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/friends/{{bobId}}"
          }
        }
      ]
    },
    {
      "name": "Conversations",
      "description": "Alice and Bob must be friends to start a conversation. Typical flow: Login (Alice) -> Start conversation (with Bob) -> Send message -> Login (Bob) -> My conversations (unread count) -> Get messages -> Mark as read.",
      "item": [
        {
          "name": "Start conversation (with Bob)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save the conversation id for the requests below ({{conversationId}}). 201 = new, 200 = already existed.",
                  "if (pm.response.code === 200 || pm.response.code === 201) pm.collectionVariables.set('conversationId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{bobId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/conversations"
          }
        },
        {
          "name": "My conversations",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/conversations"
          }
        },
        {
          "name": "Get conversation",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/conversations/{{conversationId}}"
          }
        },
        {
          "name": "Mark as read",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/conversations/{{conversationId}}/read"
          }
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Send message",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save the message id for Edit/Delete ({{messageId}})",
                  "if (pm.response.code === 201) pm.collectionVariables.set('messageId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hi! How are you?\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/conversations/{{conversationId}}/messages"
          }
        },
        {
          "name": "Get messages (newest first)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/messages?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conversations", "{{conversationId}}", "messages"],
              "query": [{ "key": "limit", "value": "50" }]
            }
          }
        },
        {
          "name": "Get older messages (before)",
          "request": {
            "description": "Set 'before' to the id of the OLDEST message you already have (the last item of the previous page).",
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/messages?limit=50&before={{messageId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conversations", "{{conversationId}}", "messages"],
              "query": [
                { "key": "limit", "value": "50" },
                { "key": "before", "value": "{{messageId}}" }
              ]
            }
          }
        },
        {
          "name": "Edit message",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hi! How are you doing?\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/messages/{{messageId}}"
          }
        },
        {
          "name": "Delete message",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/messages/{{messageId}}"
          }
        }
      ]
    }
  ]
}
